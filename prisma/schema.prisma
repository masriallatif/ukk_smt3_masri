generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int       @id @default(autoincrement())
  kode      String?   @unique
  fullname  String
  email     String    @unique
  password  String
  role      String    @default("staff")
  token     String?   @db.Text
  artikel   Artikel[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String
  artikel   Artikel[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("categories")
}

model Jurusan {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("jurusan")
}

model Artikel {
  id         Int       @id @default(autoincrement())
  title      String
  content    String    @db.Text
  status     String    @default("draft")
  categoryId Int?      @map("category_id")
  authorId   Int?      @map("author_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author     User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("artikel")
}

model TypeUnit {
  idUnitType   Int                @id @default(autoincrement()) @map("id_unit_type")
  namaTypeUnit String             @map("nama_type_unit")
  branchId     Int                @map("branch_id")
  facilities   TypeUnitFacility[]
  createAt     DateTime           @default(now()) @map("create_at")
  updateAt     DateTime           @updatedAt @map("update_at")

  @@map("tbl_type_unit")
}

model Facility {
  kodeFacility String             @id @map("kode_facility")
  namaFacility String             @map("nama_facility")
  typeUnits    TypeUnitFacility[]
  createAt     DateTime           @default(now()) @map("create_at")
  updateAt     DateTime           @updatedAt @map("update_at")

  @@map("tbl_facility")
}

model TypeUnitFacility {
  idUnitType   Int      @map("id_unit_type")
  kodeFacility String   @map("kode_facility")
  typeUnit     TypeUnit @relation(fields: [idUnitType], references: [idUnitType], onDelete: Cascade)
  facility     Facility @relation(fields: [kodeFacility], references: [kodeFacility], onDelete: Cascade)

  @@id([idUnitType, kodeFacility])
  @@index([kodeFacility])
  @@map("tbl_type_unit_facility")
}
